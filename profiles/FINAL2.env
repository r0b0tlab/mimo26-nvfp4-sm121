# FINAL2: unified memory pool so the full-attention KV can grow past the static
# split (up to ~988K for one request) while the SWA pool stays at its cap.
# DFlash draft window pinned to 4096 so the draft KV pool is ~21 MB instead of
# mirroring the target capacity (~5 GB).
TAG=FINAL2
SPEC=dflash
DFLASH_BLOCK=8
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
MEMFRAC=0.90
MAXRUN=8
EXTRA="--enable-unified-memory"
