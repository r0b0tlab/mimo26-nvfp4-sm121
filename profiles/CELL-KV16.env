# CELL KV16: triton decode attention kv-splits 8 -> 16. GB10 has 110 SMs;
# more KV splits can raise SM occupancy for short-KV decode at bs<=8.
TAG=CELL-KV16
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision --triton-attention-num-kv-splits 16'
