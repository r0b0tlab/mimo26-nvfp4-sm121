# CELL NCCL: cross-node TP=2 collectives tuning. DGX Spark RoCE fabric,
# single HCA per direction, small messages at bs<=8 decode. Ring+Simple
# avoids the LL128 protocol's extra latency variance on RoCE; env-only, no
# engine change. Also pins NCCL_MIN_NCHANNELS to the fabric's channel count.
TAG=CELL-NCCL
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
DENV='NCCL_ALGO=Ring NCCL_PROTO=Simple NCCL_MIN_NCHANNELS=8'
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
