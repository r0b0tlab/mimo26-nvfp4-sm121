# CELL COMBO: winners combined — spec geometry + kernel fusions + NCCL tuning.
# Env vars selected after the individual cells land. Placeholder until then.
TAG=CELL-COMBO
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
DENV='NCCL_ALGO=Ring NCCL_PROTO=Simple'
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
