# CELL S1: single-step spec (steps=1, draft=2). Ladder floor: if the extra
# draft forwards cost more than they return even at steps=2, this wins.
TAG=CELL-S1
SPEC=eagle
NUM_STEPS=1
DRAFT_TOKENS=2
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
