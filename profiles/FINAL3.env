# FINAL3: static pools, SWA ratio 0.02 -> ~622K full-attention tokens (the
# largest that fits the measured KV budget with the SWA pool still above its
# ~26K-token request cap).  DFlash draft window 4096 keeps the draft KV pool
# at ~21 MB instead of mirroring the target capacity.
TAG=FINAL3
SPEC=dflash
DFLASH_BLOCK=8
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
