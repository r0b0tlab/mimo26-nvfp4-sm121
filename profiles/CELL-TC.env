# CELL TC: torch.compile on decode graphs. The one big untried kernel-fusion
# lever: fuses elementwise chains around the marlin MoE + attention at
# bs<=8. Compile is slow at boot (up to ~30 min) and spikes host RAM, so
# this cell drops mem-frac 0.90 -> 0.87 (KV pool stays >> 524k ctx) to keep
# the compile spike clear of the 3 GiB mem guard. Rollback if capture fails.
TAG=CELL-TC
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.87
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision --enable-torch-compile --torch-compile-max-bs 8'
