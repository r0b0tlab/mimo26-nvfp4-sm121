# Graph-on trial of the live MTP profile. One variable: draft-extend capture.
# Same memory knobs, same multimodal pins, same 3 steps / 4 draft tokens.
# Do not raise mem-frac. Do not add FA4, DP encoder, Mooncake, or cuda_ipc.
TAG=MTP-500k-mm-graph
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
