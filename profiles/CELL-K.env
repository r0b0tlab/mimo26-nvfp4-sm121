# CELL K: fused QK-norm + RoPE kernel on top of the live 3/4 spec geometry.
# One decode-path kernel merge per layer; numerics-affecting (canary needed).
TAG=CELL-K
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision --enable-fused-qk-norm-rope'
