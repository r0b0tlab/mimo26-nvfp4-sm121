# FINAL: max context + k=8 throughput.  SWA ratio left unset so the server
# sizes the SWA pool from the request cap (~26K tokens) and gives everything
# else to the full-attention pool.  mem-frac 0.90 now that the JIT cache is warm
# (cold compile was what tripped the guard at 0.90).
TAG=FINAL
SPEC=dflash
DFLASH_BLOCK=8
PATCH_SWIZZLE=1
MEMFRAC=0.90
MAXRUN=8
