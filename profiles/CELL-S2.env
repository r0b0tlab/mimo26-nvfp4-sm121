# CELL S2: speculative steps 2, draft tokens 3. Hypothesis from the prose
# acceptance histogram: P(accept draft 3 | 2)=0.49 buys little for a third
# draft forward; steps=2 keeps tokens-per-draft-forward at the top of the
# ladder. Everything else identical to the live MTP-500k-mm-graph profile.
TAG=CELL-S2
SPEC=eagle
NUM_STEPS=2
DRAFT_TOKENS=3
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
