# CELL SI8: stream_interval 1 -> 8. Fewer detokenizer/stream bookkeeping
# round-trips per decode step; with MTP a verify step emits ~3.5 tokens so
# per-token stream pushes are pure overhead at c1. Output visible latency
# unchanged in practice (chunks arrive in ~30ms groups instead of ~11ms).
TAG=CELL-SI8
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision --stream-interval 8'
