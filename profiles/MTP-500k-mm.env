# Preferred MTP profile. Same memory knobs as the measured FINAL3-500k DFlash run.
# In-checkpoint EAGLE, 3 steps, 4 draft tokens, draft window pinned.
# This is the preferred serve. DFlash is an earlier recorded lane.
IMG=ghcr.io/r0b0tlab/sglang-mimo26-env:20260922-582389ce-mtp-mm
# Multimodal pins are the SM121 path that matched the controlled probes.
# Draft-extend CUDA graph is on. The SWA window index is filled by
# patches/sglang-582389ce/triton_backend.py. Do not set
# SGLANG_DISABLE_DRAFT_EXTEND_CUDA_GRAPH on this nightly.
# Prefill CUDA graph is off because this build disables it on a multimodal model.
# Do not add FA4, DP encoder, Mooncake, or cuda_ipc.
TAG=MTP-500k-mm
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
