# Finalized DFlash production profile.
# Memory and draft knobs match the measured FINAL3-500k systems run.
# Multimodal pins are the SM121 path: Triton vision attention, torchvision
# decode, explicit multimodal, MiMo reasoning parser. No DP encoder, no
# Mooncake cache, no CUDA-IPC feature transport (this serve is two-node TP).
# Do not set SGLANG_DISABLE_DRAFT_EXTEND_CUDA_GRAPH here. That switch is for
# the MTP SWA draft-extend capture crash, not for DFlash.
TAG=DFLASH-500k
SPEC=dflash
DFLASH_BLOCK=8
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
