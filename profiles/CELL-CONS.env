# CELL CONS: schedule_conservativeness 1.0 -> 0.3. Lets the scheduler batch
# decode steps more aggressively between prefills; c1 decode is the primary
# metric so less prefill-stealing should show directly.
TAG=CELL-CONS
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision --schedule-conservativeness 0.3'
