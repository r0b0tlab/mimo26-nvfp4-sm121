# CELL NCCLCH: NCCL_MIN_NCHANNELS=16 only (no ALGO/PROTO pin). The pinned
# Ring+Simple cell lost c1 badly; maybe channels alone (more SMs for comm)
# helps without forcing the algorithm choice.
TAG=CELL-NCCLCH
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
DENV='NCCL_MIN_NCHANNELS=16'
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
