# CELL CHUNK16: chunked prefill 8192 -> 16384. Prefill at 8k measures ~650
# tok/s; doubling the chunk halves per-chunk scheduling overhead for the
# 4-8k prompt lanes. Decode lanes should be untouched; watch TTFT medians.
TAG=CELL-CHUNK16
SPEC=eagle
DRAFT_WINDOW=4096
PATCH_SWIZZLE=1
SWA_RATIO=0.02
MEMFRAC=0.90
MAXRUN=8
CTX=524288
CHUNK=16384
MAXPREFILL=16384
EXTRA='--tool-call-parser mimo --reasoning-parser mimo --enable-multimodal --mm-attention-backend triton_attn --image-processor-backend torchvision'
