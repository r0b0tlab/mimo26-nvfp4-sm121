# W8: JIT-cache warm boot + k=8 throughput measurement.  Same as P1 but
# mem-frac 0.85 so the cold nvcc/triton compile during graph capture has
# ~5.5 GiB extra host headroom.  Kernels land in the persistent cache mounts.
TAG=W8
SPEC=dflash
DFLASH_BLOCK=8
PATCH_SWIZZLE=1
SWA_RATIO=0.1
MEMFRAC=0.85
MAXRUN=8
